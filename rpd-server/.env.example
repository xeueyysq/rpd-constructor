# Файл для локальной разработки. Настройки прода — в deploy/.env.example.
PORT=8000
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:8000

# Совпадают с dev/compose.yaml. При смене DEV_DB_PORT обновите DB_PORT.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=Rpd

# Только для разработки; в проде задайте отдельные секреты в deploy/.env.
ACCESS_TOKEN_SECRET=local-development-access-secret
REFRESH_TOKEN_SECRET=local-development-refresh-secret
