# Продовая конфигурация: скопируйте в deploy/.env и задайте свои значения.
# Адреса публичного сайта и локальный порт API.
PORT=8000
CLIENT_URL=https://rpd.uni-dubna.ru
API_URL=https://rpd.uni-dubna.ru
ALLOWED_ORIGINS=https://rpd.uni-dubna.ru

# Параметры PostgreSQL. При первой инициализации тома контейнер PostgreSQL
# берёт DB_USER, DB_PASSWORD и DB_NAME из этих же значений.
DB_HOST=db
DB_USER=postgres
# Для пароля БД сгенерируйте отдельное значение: openssl rand -hex 64
DB_PASSWORD=замените-на-случайный-пароль
DB_NAME=Rpd
DB_PORT=5432

# Сгенерируйте каждый секрет отдельно командой: openssl rand -hex 64
ACCESS_TOKEN_SECRET=замените-на-результат-openssl-rand-hex-64
REFRESH_TOKEN_SECRET=замените-на-другой-результат-openssl-rand-hex-64

# Compose из deploy/compose.yaml подставляет $ как переменную. Значение с $ заключайте в одинарные кавычки.
